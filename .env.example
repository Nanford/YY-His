# 复制为 .env.local 并填入真实密钥（.env.local 不入库）。
# 所有密钥只在服务端使用；未配置时语音链路自动降级（纯字幕 + 按钮/文字作答），流程仍可完整演示。

# DeepSeek：回答归一化（JSON mode）。缺失时归一化走规则兜底。
DEEPSEEK_API_KEY=

# 火山引擎语音技术（豆包 TTS + 大模型录音识别共用一套密钥）
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
# 可选：豆包 TTS 音色（需在火山控制台开通对应音色，2.0 音色走 seed-tts-2.0 资源）
VOLC_TTS_VOICE=zh_female_xiaohe_uranus_bigtts
# 可选：TTS 模型资源 ID（默认 seed-tts-2.0；声音复刻音色用 seed-icl-2.0）
# VOLC_TTS_RESOURCE_ID=seed-tts-2.0

# 视觉模型：画图题（画钟等）看图判定。按 OpenAI 兼容 chat/completions 多模态格式调用。
# 默认对接阿里云百炼的通义千问 VL（密钥在百炼控制台创建）。密钥缺失时画图题回落「待医生确认计分」。
DASHSCOPE_API_KEY=
# 可选：视觉模型名（默认 qwen3-vl-plus）
# VISION_MODEL=qwen3-vl-plus
# 可选：画图题「临界复核」用的模型（首轮拿不准时才调用）。默认百炼入口下为 qwen3.8-max；
# 改了 VISION_API_BASE 且未配置此项时沿用 VISION_MODEL
# VISION_ARBITRATION_MODEL=qwen3.8-max
# 可选：换其他 OpenAI 兼容厂商时，用 VISION_API_KEY（优先于 DASHSCOPE_API_KEY）+ VISION_API_BASE（不含 /chat/completions）
# VISION_API_KEY=
# VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选：合并进请求体的厂商扩展参数（JSON 对象）。走默认百炼入口时已自动关闭深度思考，一般不用配
# VISION_EXTRA_BODY={"enable_thinking":false}

# 数字人形象：sdk=商用数字人 SDK（商务开通后接入）；fallback=内置 2D 降级形象
AVATAR_MODE=fallback
